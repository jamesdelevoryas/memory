[Unit]
Description=Memory consolidator: tidy the notes (merge, correct, retire stale ones)
After=network-online.target memory.service
Wants=network-online.target

[Service]
Type=oneshot
# The dreamer's user: Claude Code is installed in its home.
User=dreamer
Group=dreamer
Environment=HOME=/var/lib/memory-dreamer
Environment=DREAMER_MODEL=opus
# MEMORY_URL, MEMORY_TOKEN (the consolidator's: consolidate, private),
# CLAUDE_CODE_OAUTH_TOKEN; written by deploy/consolidator-setup.sh.
EnvironmentFile=/etc/memory-consolidator/env
ExecStart=/usr/local/bin/memory-dreamer /usr/local/share/memory/consolidator.md
# Only after a run that finished: /health reports how long ago that was, so the
# monitor notices when consolidation stops. `+` runs it as root, outside the
# sandbox, to write into the server's directory.
ExecStartPost=+/bin/sh -c 'date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ > /var/lib/memory/last-consolidation'
TimeoutStartSec=60min

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/memory-dreamer
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
