[Unit]
Description=Memory MCP server
# The data lives on a block-storage volume mounted here.
RequiresMountsFor=/var/lib/memory
After=network-online.target
Wants=network-online.target

[Service]
User=memory
Group=memory
Environment=MEMORY_DB=/var/lib/memory/memory.db
Environment=MEMORY_TOKENS=/etc/memory/tokens
Environment=MEMORY_OAUTH_CLIENTS=/etc/memory/oauth-clients
Environment=MEMORY_PUBLIC_URL=https://@DOMAIN@
# The private IP from deploy/config when the proxy is on another machine; else 127.0.0.1.
Environment=MEMORY_ADDR=@ADDR@:8750
Environment=MEMORY_ALLOWED_HOSTS=@DOMAIN@
Environment=MEMORY_BACKUP_STAMP=/var/lib/memory/last-backup
Environment=MEMORY_CONSOLIDATION_STAMP=/var/lib/memory/last-consolidation
# Written on POST /dream; memory-dreamer.path watches it.
Environment=MEMORY_DREAM_TRIGGER=/var/lib/memory/dream-requested
# Never start on an empty directory if the volume failed to mount.
ExecStartPre=/usr/bin/mountpoint -q /var/lib/memory
ExecStart=/usr/local/bin/memory serve
# Re-reads the tokens and OAuth clients files without a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
StateDirectory=memory
StateDirectoryMode=0700

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
